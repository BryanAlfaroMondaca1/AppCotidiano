<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- CalendarView que muestra el calendario -->
    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:dateTextAppearance="?android:attr/textAppearanceLarge" />

    <!-- Botón para abrir Google Calendar -->
    <Button
        android:id="@+id/btnOpenGoogleCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#F44336"
        android:text="Abrir Google Calendar"
        android:textColor="#FFFFFF"
        android:background="#4285F4" /> <!-- Color típico de Google -->

</LinearLayout>

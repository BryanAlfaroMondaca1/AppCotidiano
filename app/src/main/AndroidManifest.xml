<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CotidianoOrganiza"
        tools:targetApi="31" >
        <activity
            android:name=".CalendarioDetalladoActivity"
            android:exported="false" />
        <activity
            android:name=".AlertaReceiver"
            android:exported="false" />

        <receiver
            android:name=".AlertaReceiver"
            android:exported="false" /> <!-- LoginActivity debe ser exportada para ser lanzable en Android 12+ -->
        <activity
            android:name=".LoginActivity"
            android:exported="true" > <!-- exported se debe establecer en true -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- MainActivity no necesita ser exportada porque no es lanzable desde el launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".RegistroActividadesActivity"
            android:exported="false" />
        <activity
            android:name=".AlertasActivity"
            android:exported="false" />
        <activity
            android:name=".AnalisisActivity"
            android:exported="false" />
        <activity
            android:name=".GamificacionActivity"
            android:exported="false" />
        <activity
            android:name=".CalendarioActivity"
            android:exported="false" />
    </application>

</manifest>